# Copy to .env and fill in. Demo mode (DEMO=1) needs none of these.
DEMO=0
AWS_PROFILE=
AWS_REGION=us-east-1
# Bedrock models
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
# AWS resources (created by infra/template.yaml)
S3_BUCKET=
OPENSEARCH_COLLECTION=
OPENSEARCH_INDEX=filings
CHAT_HISTORY_TABLE=
FILING_META_TABLE=
# Observability
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=finstack-ai
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# SEC asks for an identifying User-Agent, e.g. "finstack-ai you@email.com"
SEC_USER_AGENT=finstack-ai research contact@example.com
# Frontend -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
